{
    "name": "homesug/laravel-agent-web-search",
    "description": "Keyless web search and read tools for any Laravel AI agent: measured deadlines, batched reads, works on any provider.",
    "license": "MIT",
    "type": "library",
    "keywords": ["laravel", "ai", "agent", "web-search", "tools"],
    "require": {
        "php": "^8.2",
        "illuminate/config": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "symfony/process": "^6.0|^7.0|^8.0",
        "laravel/ai": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "HomesUg\\WebSearch\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HomesUg\\WebSearch\\WebSearchServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
