{
    "name": "ssekyanzijackson/laravel-agent-web-search",
    "description": "Give your Laravel AI agent access to the internet: keyless web search and read tools that work on any provider, with measured deadlines and batched reads.",
    "license": "MIT",
    "type": "library",
    "keywords": ["laravel", "ai", "agent", "web-search", "tools"],
    "homepage": "https://github.com/ssekyanzijackson/laravel-agent-web-search",
    "authors": [
        {
            "name": "Jackson Mwesigwa",
            "homepage": "https://github.com/ssekyanzijackson"
        }
    ],
    "support": {
        "issues": "https://github.com/ssekyanzijackson/laravel-agent-web-search/issues",
        "source": "https://github.com/ssekyanzijackson/laravel-agent-web-search"
    },
    "require": {
        "php": "^8.3",
        "illuminate/config": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "symfony/process": "^6.0|^7.0|^8.0",
        "laravel/ai": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "AgentWebSearch\\": "src/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "AgentWebSearch\\WebSearchServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
